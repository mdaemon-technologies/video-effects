{
  "name": "@mdaemon/video-effects",
  "version": "1.2.2",
  "type": "module",
  "description": "Camera background blur and replacement for WebRTC video tracks, with a track-in/track-out API built on MediaPipe selfie segmentation",
  "main": "dist/videoEffects.umd.js",
  "module": "dist/videoEffects.mjs",
  "browser": "dist/videoEffects.umd.js",
  "common": "dist/videoEffects.cjs",
  "typings": "dist/videoEffects.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && vitest run",
    "test:types": "node scripts/test-types.mjs",
    "dev-test": "vitest",
    "build": "vite build && node node_modules/typescript/bin/tsc -p tsconfig.json --emitDeclarationOnly",
    "dev": "vite build --watch",
    "pub": "npm run build && npm run test && npm run test:types && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdaemon-technologies/video-effects.git"
  },
  "keywords": [
    "video",
    "webrtc",
    "background blur",
    "virtual background",
    "background replacement",
    "segmentation",
    "mediapipe",
    "mediastreamtrack",
    "camera",
    "conferencing",
    "typescript"
  ],
  "author": {
    "name": "MDaemon Technologies, Ltd.",
    "email": "jonathan.ehman@mdaemon.com",
    "url": "https://www.mdaemon.com"
  },
  "license": "LGPL-2.1",
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/mdaemon-technologies/video-effects/issues"
  },
  "homepage": "https://github.com/mdaemon-technologies/video-effects#readme",
  "peerDependencies": {
    "@mediapipe/tasks-vision": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@mediapipe/tasks-vision": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@types/node": "^22.20.5",
    "@typescript/typescript6": "^6.0.2",
    "jsdom": "^31.0.0",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/videoEffects.d.ts",
      "import": "./dist/videoEffects.mjs",
      "require": "./dist/videoEffects.cjs",
      "default": "./dist/videoEffects.umd.js"
    }
  }
}
